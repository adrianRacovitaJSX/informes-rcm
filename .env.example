# Postgres (Neon) — base de datos propia de RCM
DATABASE_URL=
AUTH_SECRET=
# Cloudflare R2 (fotos, vídeos y PDFs). Sin credenciales, en local se guardan en public/uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=informes-rcm
R2_PUBLIC_URL=
# URL pública de la app (enlaces de los QR del PDF)
APP_URL=https://informes.revisioncochemadrid.es
# Resend: envío del informe al cliente por email (dominio revisioncochemadrid.es verificado en Resend)
RESEND_API_KEY=
EMAIL_FROM="Revisión Coche Madrid <informes@revisioncochemadrid.es>"
EMAIL_REPLY_TO=contacto@revisioncochemadrid.es
